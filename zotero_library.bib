  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1910.02151},
  urldate = {2025-01-27},
  abstract = {Unlike in statistical compression, where Shannon's entropy is a definitive lower bound, no such clear measure exists for the compressibility of repetitive sequences. Since statistical entropy does not capture repetitiveness, ad-hoc measures like the size \$z\$ of the Lempel--Ziv parse are frequently used to estimate it. The size \$b \textbackslash le z\$ of the smallest bidirectional macro scheme captures better what can be achieved via copy-paste processes, though it is NP-complete to compute and it is not monotonic upon symbol appends. Recently, a more principled measure, the size \$\textbackslash gamma\$ of the smallest string \textbackslash emph\textbraceleft attractor\textbraceright, was introduced. The measure \$\textbackslash gamma \textbackslash le b\$ lower bounds all the previous relevant ones, yet length-\$n\$ strings can be represented and efficiently indexed within space \$O(\textbackslash gamma\textbackslash log\textbackslash frac\textbraceleft n\textbraceright\textbraceleft\textbackslash gamma\textbraceright )\$, which also upper bounds most measures. While \$\textbackslash gamma\$ is certainly a better measure of repetitiveness than \$b\$, it is also NP-complete to compute and not monotonic, and it is unknown if one can always represent a string in \$o(\textbackslash gamma\textbackslash log n)\$ space. In this paper, we study an even smaller measure, \$\textbackslash delta \textbackslash le \textbackslash gamma\$, which can be computed in linear time, is monotonic, and allows encoding every string in \$O(\textbackslash delta\textbackslash log\textbackslash frac\textbraceleft n\textbraceright\textbraceleft\textbackslash delta\textbraceright )\$ space because \$z = O(\textbackslash delta\textbackslash log\textbackslash frac\textbraceleft n\textbraceright\textbraceleft\textbackslash delta\textbraceright )\$. We show that \$\textbackslash delta\$ better captures the compressibility of repetitive strings. Concretely, we show that (1) \$\textbackslash delta\$ can be strictly smaller than \$\textbackslash gamma\$, by up to a logarithmic factor; (2) there are string families needing \$\textbackslash Omega(\textbackslash delta\textbackslash log\textbackslash frac\textbraceleft n\textbraceright\textbraceleft\textbackslash delta\textbraceright )\$ space to be encoded, so this space is optimal for every \$n\$ and \$\textbackslash delta\$; (3) one can build run-length context-free grammars of size \$O(\textbackslash delta\textbackslash log\textbackslash frac\textbraceleft n\textbraceright\textbraceleft\textbackslash delta\textbraceright )\$, whereas the smallest (non-run-length) grammar can be up to \$\textbackslash Theta(\textbackslash log n/\textbackslash log\textbackslash log n)\$ times larger; and (4) within \$O(\textbackslash delta\textbackslash log\textbackslash frac\textbraceleft n\textbraceright\textbraceleft\textbackslash delta\textbraceright )\$ space we can not only...},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Data Structures and Algorithms}
}

