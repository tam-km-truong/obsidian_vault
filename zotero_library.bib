@inproceedings{kociumakaDefinitiveMeasureRepetitiveness2020,
  title = {Towards a {{Definitive Measure}} of {{Repetitiveness}}},
  booktitle = {{{LATIN}} 2020: {{Theoretical Informatics}}},
  author = {Kociumaka, Tomasz and Navarro, Gonzalo and Prezza, Nicola},
  editor = {Kohayakawa, Yoshiharu and Miyazawa, Fl{\'a}vio Keidi},
  year = 2020,
  pages = {207--219},
  publisher = {Springer International Publishing},
  address = {Cham},
  doi = {10.1007/978-3-030-61792-9_17},
  abstract = {Unlike in statistical compression, where Shannon's entropy is a definitive lower bound, no such clear measure exists for the compressibility of repetitive sequences. Since statistical entropy does not capture repetitiveness, ad-hoc measures like the size z of the Lempel--Ziv parse are frequently used to estimate repetitiveness. Recently, a more principled measure, the size \$\$\textbackslash gamma \$\${$\gamma$}of the smallest string attractor, was introduced. The measure \$\$\textbackslash gamma \$\${$\gamma$}lower bounds all the previous relevant ones (including z), yet length-n strings can be represented and efficiently indexed within space \$\$O(\textbackslash gamma \textbackslash log \textbackslash frac\textbraceleft n\textbraceright\textbraceleft\textbackslash gamma \textbraceright )\$\$O({$\gamma$}logn{$\gamma$}), which also upper bounds most measures (including z). While \$\$\textbackslash gamma \$\${$\gamma$}is certainly a better measure of repetitiveness than z, it is NP-complete to compute, and no \$\$o(\textbackslash gamma \textbackslash log n)\$\$o({$\gamma$}logn)-space representation of strings is known. In this paper, we study a smaller measure, \$\$\textbackslash delta \textbackslash le \textbackslash gamma \$\${$\delta\leq\gamma$}, which can be computed in linear time. We show that \$\$\textbackslash delta \$\${$\delta$}better captures the compressibility of repetitive strings. For every length n and every value \$\$\textbackslash delta \textbackslash ge 2\$\${$\delta\geq$}2, we construct a string such that \$\$\textbackslash gamma = \textbackslash varOmega (\textbackslash delta \textbackslash log \textbackslash frac\textbraceleft n\textbraceright\textbraceleft\textbackslash delta \textbraceright )\$\${$\gamma$}=\textohm ({$\delta$}logn{$\delta$}). Still, we show a representation of any string S in \$\$O(\textbackslash delta \textbackslash log \textbackslash frac\textbraceleft n\textbraceright\textbraceleft\textbackslash delta \textbraceright )\$\$O({$\delta$}logn{$\delta$})space that supports direct access to any character S[i] in time \$\$O(\textbackslash log \textbackslash frac\textbraceleft n\textbraceright\textbraceleft\textbackslash delta \textbraceright )\$\$O(logn{$\delta$})and finds the occ occurrences of any pattern \$\$P[1\textbraceleft.\textbackslash,.\textbraceright m]\$\$P[1..m]in time \$\$O(m\textbackslash log n + occ\textbackslash log \textasciicircum\textbackslash varepsilon n)\$\$O(mlogn+occlog{$\varepsilon$}n)for any constant \$\$\textbackslash varepsilon {$>$}0\$\${$\varepsilon>$}0. Further, we prove that no \$\$o(\textbackslash delta \textbackslash log n)\$\$o({$\delta$}logn)-space representation exists: for every length n and every value \$\$2\textbackslash le \textbackslash delta \textbackslash le n\textasciicircum\textbraceleft 1-\textbackslash varepsilon \textbraceright\$\$2{$\leq\delta\leq$}n1-{$\varepsilon$}, we exhibit a string family whose elements can only be encoded in \$\$\textbackslash varOmega (\textbackslash delta \textbackslash log \textbackslash frac\textbraceleft n\textbraceright\textbraceleft\textbackslash delta \textbraceright )\$\$\textohm ({$\delta$}logn{$\delta$})space. We complete our characterization of \$\$\textbackslash delta \$\${$\delta$}by showing that, although \$\$\textbackslash gamma \$\${$\gamma$}, z, and other repetitiveness measures are always \$\$O(\textbackslash delta \textbackslash log \textbackslash frac\textbraceleft n\textbraceright\textbraceleft\textbackslash delta \textbraceright )\$\$O({$\delta$}logn{$\delta$}), for strings of any length n, the smallest context-free grammar can be of size \$\$\textbackslash varOmega (\textbackslash delta \textbackslash log \textasciicircum 2 n/\textbackslash log \textbackslash log n)\$\$\textohm ({$\delta$}log2n/loglogn). No such separation is known for \$\$\textbackslash gamma \$\${$\gamma$}.},
  isbn = {978-3-030-61792-9},
  langid = {english}
}

